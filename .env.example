# Telegram Bot
BOT_TOKEN=your_bot_token_here
SUPER_ADMIN_ID=123456789
TRACKING_CHANNEL_ID=-1001234567890

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/moderation.db

